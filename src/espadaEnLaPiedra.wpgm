import wollok.game.*
import src.juego.*
import src.elementosVisuales.*
import src.espadaVisual.*
import src.barraVisual.*
import src.relojDelDesafio.*


program espadaEnLaPiedra {
  game.title("La Espada en la Piedra")
  game.width(10)
  game.height(10)
  game.cellSize(75)
  game.boardGround("fondo_castillo.png")

  // Mapeo de teclas direccionales
keyboard.up().onPressDo {
    relojDelDesafio.presionar("arriba")
}

keyboard.down().onPressDo {
    relojDelDesafio.presionar("abajo")
}

keyboard.left().onPressDo {
    relojDelDesafio.presionar("izquierda")
}

keyboard.right().onPressDo {
    relojDelDesafio.presionar("derecha")
}

// Tecla ESPACIO: Inicia el juego o lo reinicia si ya terminó
  keyboard.space().onPressDo {
      if (!juego.estaIniciado()) {
          juego.comenzarJuego()
      } else if (juego.estaTerminado()) {
          relojDelDesafio.reiniciar()
      }
  }
// Timer recurrente para actualizar el tiempo y la barra
  game.onTick(50, "relojDesafioTick", { relojDelDesafio.avanzarTiempo() })

  // Elementos visuales en el tablero
  game.addVisual(espadaVisual)
  game.addVisual(flechaEnPantalla)
  game.addVisual(barraVisual)
  game.addVisual(barraTiempoVisual)
  game.addVisual(cartelVictoria)
  game.addVisual(cartelDerrota)
  game.addVisual(cartelReinicio)
  game.addVisual(fondoMenuVisual)
  game.addVisual(cartelMenu)
  game.addVisual(cartelFeedback)
  game.addVisual(menuTextoNormal)
  game.addVisual(menuTextoCebado)
  game.addVisual(menuTextoBajoneado)
  game.addVisual(cartelTutorial)
/*
  // Inicializa la partida
  juego.iniciarPartida()
  relojDelDesafio.iniciar()
*/

  game.start()
}
