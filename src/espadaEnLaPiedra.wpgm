import wollok.game.*
import src.juego.*
import src.eventos.*

program espadaEnLaPiedra {
  game.title("La Espada en la Piedra")
  game.width(10)
  game.height(10)

  // Mapeo de teclas direccionales
  keyboard.up().onPressDo { juego.procesarDireccion("arriba") }
  keyboard.down().onPressDo { juego.procesarDireccion("abajo") }
  keyboard.left().onPressDo { juego.procesarDireccion("izquierda") }
  keyboard.right().onPressDo { juego.procesarDireccion("derecha") }

  // Tecla para reiniciar la partida
  keyboard.space().onPressDo { juego.reiniciarPartida() }

  // Elementos visuales en el tablero
  game.addVisual(flechaEnPantalla)
  game.addVisual(visualProgreso)
  game.addVisual(visualPuntos)
  game.addVisual(visualRacha)
  game.addVisual(visualEstado)
  game.addVisual(cartelVictoria)
  game.addVisual(cartelReinicio)

  // Inicializa la partida
  juego.iniciarPartida()

  game.start()
}
